---
/**
 * The opening of a page in the ASCII-stage design: a small mono label, a big
 * serif title and a sentence, on one half of the screen; the ASCII stage owns
 * the other half. Text arrives with the same blur-in as the lab hero.
 */
type Props = {
  label?: string;
  title: string;
  description?: string;
  back?: { href: string; label: string };
  /** Which half the text sits on (the ASCII takes the other). */
  align?: "left" | "right" | "center";
  /** Full screen height (detail pages) or shorter (list pages). */
  tall?: boolean;
  /** Title size. */
  size?: "xl" | "lg";
  /** Phones: centre the text vertically instead of resting it at the bottom. */
  mobileCenter?: boolean;
  /** Scroll hint at the foot of a full-height intro. Defaults to on with `tall`. */
  scrollCue?: boolean;
  id?: string;
  /** Extra classes for the text column (e.g. a backdrop). */
  class?: string;
};

const { label, title, description, back, align = "left", tall = false, size = "xl", mobileCenter = false, scrollCue = tall, id, class: className } = Astro.props;
const half =
  align === "left"
    ? "md:w-1/2 items-start text-left"
    : align === "right"
      ? "md:w-1/2 md:ml-auto items-end text-right"
      : "mx-auto max-w-3xl items-center text-center";
---

<section
  id={id}
  class:list={[
    "relative flex flex-col md:justify-center",
    // Phones: the ASCII is a band across the top, so the text sits below it.
    tall
      ? [
          "min-h-[calc(100svh-6rem)] md:pb-16 md:justify-center",
          mobileCenter ? "justify-center pb-[12svh] md:pt-0" : "justify-end pb-[14svh]",
        ]
      : "min-h-[62svh] pt-[40svh] pb-16 md:pt-16 md:pb-20",
  ]}
>
  <div class:list={["flex flex-col gap-7", half, className]}>
    {
      back && (
        <a href={back.href} data-reveal data-edge class="font-mono sp-link sp-back cta-pill" style="--i:0; --nudge:-4px">
          <span aria-hidden="true">←</span> {back.label}
        </a>
      )
    }
    {
      label && (
        <p data-reveal data-edge class="eyebrow" style="--i:1">
          {label}
        </p>
      )
    }
    <h1
      data-reveal
      data-edge
      class:list={[
        "display",
        size === "xl" ? "text-5xl md:text-7xl leading-[0.98]" : "text-4xl md:text-6xl leading-[1.02]",
      ]}
      style="--i:2"
    >
      {title}
    </h1>
    {
      description && (
        <p data-reveal data-edge class="max-w-md font-serif text-xl leading-snug opacity-80" style="--i:3">
          {description}
        </p>
      )
    }
    <slot />
  </div>
  {
    scrollCue && (
      <p
        data-reveal
        style="--i:4"
        aria-hidden="true"
        class:list={[
          "scroll-cue hidden md:block absolute bottom-6 font-mono text-[10px] uppercase tracking-[0.3em] opacity-50",
          align === "left" ? "left-0" : align === "right" ? "right-0 text-right" : "inset-x-0 mx-auto w-fit text-center",
        ]}
      >
        Scroll
      </p>
    )
  }
</section>

<style is:global>
  .scroll-cue::after {
    content: "";
    display: block;
    width: 1px;
    height: 36px;
    margin-top: 10px;
    background: currentColor;
    animation: cue 2.4s cubic-bezier(0.6, 0, 0.2, 1) infinite;
  }
  .scroll-cue.text-center::after {
    margin-inline: auto;
  }
  .scroll-cue.text-right::after {
    margin-left: auto;
  }
  @keyframes cue {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
</style>

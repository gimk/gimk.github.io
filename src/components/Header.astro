---
import Container from "@components/Container.astro";
import InteractionSound from "./InteractionSound.astro";
import { getCollection } from "astro:content";

const NAV = [
  { href: "/projects", label: "Projects" },
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

/** Quick access to the most recent project, whichever it is. */
const latest = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <div class="flex items-center gap-4 sm:gap-6">
      <InteractionSound preset="link">
        <a
          style="cursor: url('/cursor-hover.svg') 16 16, auto !important;"
          href="/"
          aria-label="Grouink grouink"
          ><div>
          <svg
            class="cochon-svg text-orange-900 dark:text-slate-100"
            aria-hidden="true"
            width="40"
            height="40"
            viewBox="0 0 200 200"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <clipPath id="pig-clip"><circle cx="100" cy="100" r="100" /></clipPath>
            </defs>
            <g clip-path="url(#pig-clip)" fill="currentColor">
              <circle class="pig-hole" cx="100" cy="100" r="100" />
              <ellipse class="pig-body" cx="100" cy="222" rx="92" ry="62" />
              <g class="pig-rig">
                <g class="pig-ears" stroke="currentColor" stroke-width="12" stroke-linejoin="round">
                  <polygon class="pig-ear pig-ear-l" points="46,38 96,70 54,104" />
                  <polygon class="pig-ear pig-ear-r" points="154,38 104,70 146,104" />
                </g>
                <circle class="pig-head" cx="100" cy="113" r="63" />
                <g class="pig-face">
                  <ellipse class="pig-eye pig-hole" cx="81" cy="94" rx="8" ry="8" />
                  <ellipse class="pig-eye pig-hole" cx="119" cy="94" rx="8" ry="8" />
                  <g class="pig-snout">
                    <ellipse class="pig-hole" cx="100" cy="132" rx="28" ry="17" />
                    <circle cx="89.5" cy="132" r="5" />
                    <circle cx="110.5" cy="132" r="5" />
                  </g>
                </g>
              </g>
            </g>
          </svg>
        </div>
      </a>
      </InteractionSound>
      {latest && (
        <InteractionSound preset="button">
          <a
            href={`/projects/${latest.id}`}
            class="latest-link header-pill group flex items-center gap-2.5 h-10 pl-3.5 pr-4 rounded-full transition-colors duration-300"
            aria-label={`New project: ${latest.data.title}`}
          >
            <span class="new-dot" aria-hidden="true"></span>
            <span class="font-mono text-[11px] uppercase tracking-[0.2em] opacity-60 hidden sm:inline" aria-hidden="true">New</span>
            <span class="latest-title font-mono text-[11px] uppercase tracking-[0.12em] text-ink" aria-hidden="true">{latest.data.title}</span>
          </a>
        </InteractionSound>
      )}
      </div>
      <nav class="header-pill flex items-center gap-0.5 sm:gap-1 pl-2 pr-1 py-0.5 rounded-full" aria-label="Main">
        <ul class="hidden sm:flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em]">
          {NAV.map((item) => (
            <li>
              <InteractionSound preset="link">
                <a
                  href={item.href}
                  class:list={["nav-link px-2 py-2 flex items-center gap-2", { "is-current": isCurrent(item.href) }]}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  <span class="nav-dot" aria-hidden="true"></span>
                  {item.label}
                </a>
              </InteractionSound>
            </li>
          ))}
        </ul>
        <!-- Phones: the links move into a full-screen menu. -->
        <button
          id="menu-button"
          type="button"
          class="sm:hidden px-3 py-2 font-mono text-[11px] uppercase tracking-[0.2em] opacity-80"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          Menu
        </button>
        <span class="w-px h-4 bg-current opacity-15 mx-1" aria-hidden="true"></span>
        <button
          id="sound-button"
          aria-label="Toggle sound button"
          class="group p-2 flex items-center opacity-60 hover:opacity-100 transition duration-300 ease-in-out sm:hover:text-accent-primary"
        >
          <svg
            class="sound-icon sm:group-hover:stroke-accent-primary transition-colors duration-300 ease-in-out"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
            <path class="sound-waves" d="M15.54 8.46a5 5 0 0 1 0 7.07 M19.07 4.93a10 10 0 0 1 0 14.14" />
            <line class="sound-cross-1" x1="15" y1="9" x2="21" y2="15" />
            <line class="sound-cross-2" x1="21" y1="9" x2="15" y2="15" />
          </svg>
        </button>

        <InteractionSound
          id="theme-sound-wrapper"
          preset="toggle"
          click="toggle_on"
        >
          <button
            id="theme-button"
            aria-label="Toggle theme button"
            class="group p-2 flex items-center opacity-60 hover:opacity-100 transition duration-300 ease-in-out sm:hover:text-accent-primary"
          >
            <svg
              class="sun-moon sm:group-hover:stroke-accent-primary transition-colors duration-300 ease-in-out"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
            >
              <mask class="moon-mask" id="moon-mask">
                <rect x="0" y="0" width="100%" height="100%" fill="white" />
                <circle cx="24" cy="10" r="6" fill="black" />
              </mask>
              <circle
                class="sun-core"
                cx="12"
                cy="12"
                r="6"
                mask="url(#moon-mask)"
                fill="currentColor"
                stroke="none"
              />
              <g class="sun-beams" stroke="currentColor">
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </g>
            </svg>
          </button>
        </InteractionSound>
      </nav>
    </div>
  </Container>
  <div id="mobile-menu" class="mobile-menu sm:hidden" hidden>
    <nav aria-label="Main" class="flex flex-col gap-2">
      {NAV.map((item, i) => (
        <a
          href={item.href}
          class:list={["font-serif text-5xl tracking-tight", { "text-accent-primary": isCurrent(item.href) }]}
          style={`--i:${i}`}
          data-reveal
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    {latest && (
      <a href={`/projects/${latest.id}`} class="mt-10 eyebrow opacity-60" style="--i:3" data-reveal>
        New · {latest.data.title} →
      </a>
    )}
  </div>
</header>

<script>
  import { toggleMute, playSound } from "@lib/audio-manager";
  
  function initSoundToggle() {
    const btn = document.getElementById("sound-button");
    if (btn && !btn.hasAttribute("data-listener-added")) {
      btn.addEventListener("click", () => {
        const isMuted = toggleMute();
        if (!isMuted) {
           playSound("toggle_on");
        }
      });
      btn.setAttribute("data-listener-added", "true");
    }
  }

  document.addEventListener("DOMContentLoaded", initSoundToggle);

  // Phone menu: a full-screen overlay; closes on a link, Escape or navigation.
  function initMenu() {
    const btn = document.getElementById("menu-button");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu || btn.hasAttribute("data-listener-added")) return;
    btn.setAttribute("data-listener-added", "true");
    const set = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "Close" : "Menu";
      document.documentElement.classList.toggle("menu-open", open);
    };
    btn.addEventListener("click", () => set(menu.hidden));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) set(false);
    });
  }
  document.addEventListener("astro:page-load", () => {
    document.documentElement.classList.remove("menu-open");
    initMenu();
  });
  document.addEventListener("astro:after-swap", initSoundToggle);


  // 1 / 2 / 3 open Projects, Work and Blog from any page.
  const PAGES: Record<string, string> = { "1": "/projects", "2": "/work", "3": "/blog" };
  document.addEventListener("keydown", (e) => {
    const href = PAGES[e.key];
    if (!href || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey || e.defaultPrevented) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    e.preventDefault();
    location.href = href;
  });
</script>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 1.5rem 3rem;
    background: rgb(var(--color-page));
    /* Links reveal quicker and tighter than page text. Toggling [hidden]
       restarts the animation, so it replays every time the menu opens. */
    --reveal-duration: 0.6s;
    --reveal-step: 60ms;
    --reveal-base: 0ms;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
  /* Shared backdrop for the header's pills: readable over the ASCII and content. */
  .header-pill {
    background: rgb(var(--color-page) / 0.78);
    border: 1px solid rgb(var(--color-ink) / 0.08);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  /* The border needs a touch more contrast on the dark page. */
  :global(html.dark) .header-pill {
    border-color: rgb(var(--color-ink) / 0.1);
  }
  a.header-pill:hover {
    background: rgb(var(--color-page) / 0.95);
  }
  /* Pulsing "new" dot. */
  .new-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: rgb(var(--color-accent));
    flex-shrink: 0;
  }
  .new-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: new-pulse 2.4s ease-out infinite;
  }
  @keyframes new-pulse {
    from { transform: scale(1); opacity: 0.6; }
    to { transform: scale(3.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .new-dot::after { animation: none; }
  }
  .nav-link {
    opacity: 0.75;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-current {
    opacity: 1;
  }
  .nav-link.is-current {
    color: rgb(var(--color-accent));
  }
  .nav-dot {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: currentColor;
    transform: scale(0);
    transition: transform 0.3s var(--ease-out-soft);
  }
  .nav-link:hover .nav-dot,
  .nav-link.is-current .nav-dot {
    transform: scale(1);
  }
  /* Timing shared by the theme and sound icons. */
  header {
    --duration: 500ms;
    --ease-elastic: cubic-bezier(0.5, 1.25, 0.75, 1.25);
  }

  /* Theme icon: the sun's mask slides in to make a moon. */
  .sun-moon .moon-mask circle {
    transition:
      cx var(--duration) var(--ease-elastic),
      cy var(--duration) var(--ease-elastic),
      transform var(--duration) var(--ease-elastic);
  }
  :global(.dark) .sun-moon .moon-mask circle {
    cx: 17;
    cy: 11;
    /* Fallback for browsers that can't transition cx. */
    transform: translateX(-7px) translateY(1px);
  }
  @supports (cx: 17) {
    :global(.dark) .sun-moon .moon-mask circle {
      transform: none;
    }
  }
  .sun-moon .sun-core {
    transition: transform var(--duration) var(--ease-elastic);
    transform-origin: center;
  }
  :global(.dark) .sun-moon .sun-core {
    transform: scale(1.75);
  }
  .sun-moon .sun-beams {
    transition:
      transform var(--duration) var(--ease-elastic),
      opacity var(--duration) ease-in-out;
    transform-origin: center;
  }
  :global(.dark) .sun-moon .sun-beams {
    transform: rotate(-45deg);
    opacity: 0;
  }

  /* Sound icon: the waves collapse into a cross when muted. */
  .sound-icon .sound-waves {
    transition:
      opacity var(--duration) ease-in-out,
      transform var(--duration) var(--ease-elastic);
    transform-origin: center;
  }
  .sound-icon .sound-cross-1,
  .sound-icon .sound-cross-2 {
    transition:
      opacity var(--duration) ease-in-out,
      transform var(--duration) var(--ease-elastic);
    transform-origin: 18px 12px;
    opacity: 0;
    transform: scale(0.5) rotate(-45deg);
  }
  :global(.muted) .sound-icon .sound-waves {
    opacity: 0;
    transform: translateX(-5px) scale(0.5);
  }
  :global(.muted) .sound-icon .sound-cross-1,
  :global(.muted) .sound-icon .sound-cross-2 {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  /* Pig: JS drives --lx/--ly (look direction, -1..1) and --sniff (0..1);
     each layer moves by its own amount, in SVG units. */
  .cochon-svg {
    --lx: 0;
    --ly: 0;
    --sniff: 0;
    overflow: hidden;
  }
  .cochon-svg .pig-hole {
    fill: rgb(var(--color-page));
  }
  .pig-rig {
    transform-origin: 100px 160px;
    transform: rotate(calc(var(--lx) * 6deg));
  }
  .pig-ears {
    transform: translate(calc(var(--lx) * 4px), calc(var(--ly) * 4px));
  }
  .pig-head {
    transform: translate(calc(var(--lx) * 7px), calc(var(--ly) * 7px));
  }
  .pig-face {
    transform: translate(calc(var(--lx) * 18px), calc(var(--ly) * 15px));
  }
  .pig-snout {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(calc(1 + var(--sniff) * 0.1), calc(1 + var(--sniff) * 0.06));
  }
  .pig-eye {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 70ms ease-in;
  }
  .cochon-svg.is-blinking .pig-eye {
    transform: scaleY(0.12);
  }
  .pig-ear {
    transform-box: fill-box;
  }
  .pig-ear-l {
    transform-origin: 90% 75%;
  }
  .pig-ear-r {
    transform-origin: 10% 75%;
  }
  .pig-ear.is-flicking {
    animation: pig-ear-flick 420ms cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .pig-ear-r.is-flicking {
    animation-name: pig-ear-flick-r;
  }
  @keyframes pig-ear-flick {
    30% { transform: rotate(-14deg); }
    60% { transform: rotate(5deg); }
  }
  @keyframes pig-ear-flick-r {
    30% { transform: rotate(14deg); }
    60% { transform: rotate(-5deg); }
  }
  .cochon-svg.is-bouncing {
    animation: pig-bounce 380ms cubic-bezier(0.3, 0.7, 0.4, 1.4);
  }
  @keyframes pig-bounce {
    25% { transform: scale(1.12, 0.88); }
    55% { transform: scale(0.94, 1.08); }
  }
</style>

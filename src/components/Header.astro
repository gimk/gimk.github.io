---
import Container from "@components/Container.astro";
import InteractionSound from "./InteractionSound.astro";
import { getCollection } from "astro:content";

type Props = {
  /** Transparent header without blur, border or dotted strip. */
  bare?: boolean;
};

const { bare = false } = Astro.props;

const NAV = [
  { href: "/projects", label: "Projects" },
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

/** Quick access to the most recent project, whichever it is. */
const latest = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
---

<header class:list={[{ "header-bare": bare }]}>
  <Container hideLines={true}>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <div class="flex items-center gap-4">
      <InteractionSound preset="link">
        <a
          style="cursor: url('/cursor-hover.svg') 16 16, auto !important;"
          href="/"
          aria-label="Grouink grouink"
          ><div>
          <svg
            class="cochon-svg"
            aria-hidden="true"
            width="200"
            height="200"
            viewBox="0 0 200 200"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            style="width: 40px; height: 40px;"
          >
            <g clip-path="url(#clip0_2313_5602)">
              <circle
                cx="100"
                cy="100"
                r="100"
                class="fill-orange-50 dark:fill-slate-950"></circle>

              <path
                id="right-ear"
                class="fill-orange-900 dark:fill-slate-100"
                d="M152.256 98.9896C152.085 99.4168 151.993 99.8496 152.012 100.306C152.851 120.331 190.403 165.414 208.086 185.745C209.925 187.86 208.856 191.052 206.071 191.798L105.09 218.854C102.537 219.539 99 217.725 99 215.215V90.3436C99 89.3302 100.43 88.3593 101.193 87.6482L132.52 58.4687C132.837 58.1736 133.204 57.9305 133.605 57.7495L158.821 46.3752C161.691 45.081 164.933 47.3168 164.507 50.2964L160.559 77.9293C160.518 78.2132 160.444 78.4917 160.337 78.7596L152.256 98.9896Z"
              ></path>
              <path
                id="left-ear"
                class="fill-orange-900 dark:fill-slate-100"
                d="M47.744 98.9896C47.9147 99.4168 48.0069 99.8496 47.9878 100.306C47.1494 120.331 9.5965 165.414 -8.08553 185.745C-9.92479 187.86 -8.85643 191.052 -6.07075 191.798L94.9099 218.854C97.4631 219.539 101 217.725 101 215.215V90.3436C101 89.3302 99.5702 88.3593 98.8068 87.6482L67.4799 58.4687C67.1631 58.1736 66.7964 57.9305 66.3951 57.7495L41.1788 46.3752C38.3094 45.081 35.0674 47.3168 35.4932 50.2964L39.4414 77.9293C39.482 78.2132 39.5565 78.4917 39.6635 78.7596L47.744 98.9896Z"
              ></path>

              <circle
                id="head"
                class="fill-orange-900 dark:fill-slate-100"
                cx="100"
                cy="113"
                r="63"></circle>

              <g id="snout-group">
                <path
                  class="fill-orange-50 dark:fill-slate-950"
                  d="M100.5 150C84.7599 150 72 142.165 72 132.5C72 122.835 84.7599 115 100.5 115C116.24 115 129 122.835 129 132.5C129 142.165 116.24 150 100.5 150Z"
                ></path>
                <circle
                  class="fill-orange-900 dark:fill-slate-100"
                  cx="89.5"
                  cy="132.5"
                  r="5.5"></circle>
                <circle
                  class="fill-orange-900 dark:fill-slate-100"
                  cx="110.5"
                  cy="132.5"
                  r="5.5"></circle>
              </g>

              <ellipse
                id="left-eye"
                class="fill-orange-50 dark:fill-slate-950"
                cx="81"
                cy="94"
                rx="8"
                ry="8"
                style="transition: ry 0.08s ease-in-out;"></ellipse>
              <ellipse
                id="right-eye"
                class="fill-orange-50 dark:fill-slate-950"
                cx="120"
                cy="94"
                rx="8"
                ry="8"
                style="transition: ry 0.08s ease-in-out;"></ellipse>
            </g>
            <defs>
              <clipPath id="clip0_2313_5602">
                <rect
                  width="200"
                  height="200"
                  rx="100"
                  fill="white"
                  class="dark:fill-clip-bg"></rect>
              </clipPath>
            </defs>
          </svg>
        </div>
      </a>
      </InteractionSound>
      {latest && (
        <InteractionSound preset="button">
          <a
            href={`/projects/${latest.id}`}
            class="latest-link header-pill group flex items-center gap-2 pl-2.5 pr-3 py-1.5 rounded-full transition-colors duration-300 text-xs"
          >
            <svg width="12" height="12" viewBox="12.7 17.8 37 37" class="text-accent-primary shrink-0" fill="currentColor" aria-hidden="true">
              <path d="M 31.2344 54.7305 C 31.8438 54.7305 32.2891 54.2852 32.4062 53.6524 C 34.0703 40.8086 35.8750 38.8633 48.5781 37.4570 C 49.2344 37.3867 49.6797 36.8945 49.6797 36.2852 C 49.6797 35.6758 49.2344 35.2070 48.5781 35.1133 C 35.8750 33.7070 34.0703 31.7617 32.4062 18.9180 C 32.2891 18.2852 31.8438 17.8633 31.2344 17.8633 C 30.6250 17.8633 30.1797 18.2852 30.0860 18.9180 C 28.4219 31.7617 26.5938 33.7070 13.9140 35.1133 C 13.2344 35.2070 12.7891 35.6758 12.7891 36.2852 C 12.7891 36.8945 13.2344 37.3867 13.9140 37.4570 C 26.5703 39.1211 28.3281 40.8321 30.0860 53.6524 C 30.1797 54.2852 30.6250 54.7305 31.2344 54.7305 Z"></path>
            </svg>
            <span class="opacity-60 hidden sm:inline">Last project</span>
            <span class="opacity-30 hidden sm:inline" aria-hidden="true">·</span>
            <span class="text-black dark:text-white">{latest.data.title}</span>
            <span class="opacity-60 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:text-accent-primary" aria-hidden="true">→</span>
          </a>
        </InteractionSound>
      )}
      </div>
      <nav class="header-pill flex items-center gap-0.5 sm:gap-1 pl-2 pr-1 py-0.5 rounded-full" aria-label="Main">
        <ul class="flex items-center gap-1 sm:gap-3 font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.2em]">
          {NAV.map((item) => (
            <li>
              <InteractionSound preset="link">
                <a
                  href={item.href}
                  class:list={["nav-link px-2 py-2 flex items-center gap-2", { "is-current": isCurrent(item.href) }]}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  <span class="nav-dot" aria-hidden="true"></span>
                  {item.label}
                </a>
              </InteractionSound>
            </li>
          ))}
        </ul>
        <span class="hidden sm:block w-px h-4 bg-current opacity-15 mx-1" aria-hidden="true"></span>
        <button
          id="sound-button"
          aria-label="Toggle sound button"
          class="group p-2 flex items-center opacity-60 hover:opacity-100 transition duration-300 ease-in-out sm:hover:text-accent-primary"
        >
          <svg
            class="sound-icon sm:group-hover:stroke-accent-primary transition-colors duration-300 ease-in-out"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
            <path class="sound-waves" d="M15.54 8.46a5 5 0 0 1 0 7.07 M19.07 4.93a10 10 0 0 1 0 14.14" />
            <line class="sound-cross-1" x1="15" y1="9" x2="21" y2="15" />
            <line class="sound-cross-2" x1="21" y1="9" x2="15" y2="15" />
          </svg>
        </button>

        <InteractionSound
          id="theme-sound-wrapper"
          preset="toggle"
          click="toggle_on"
        >
          <button
            id="theme-button"
            aria-label="Toggle theme button"
            class="group p-2 flex items-center opacity-60 hover:opacity-100 transition duration-300 ease-in-out sm:hover:text-accent-primary"
          >
            <svg
              class="sun-moon sm:group-hover:stroke-accent-primary transition-colors duration-300 ease-in-out"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
            >
              <mask class="moon-mask" id="moon-mask">
                <rect x="0" y="0" width="100%" height="100%" fill="white" />
                <circle cx="24" cy="10" r="6" fill="black" />
              </mask>
              <circle
                class="sun-core"
                cx="12"
                cy="12"
                r="6"
                mask="url(#moon-mask)"
                fill="currentColor"
                stroke="none"
              />
              <g class="sun-beams" stroke="currentColor">
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </g>
            </svg>
          </button>
        </InteractionSound>
      </nav>
    </div>
  </Container>
</header>

<script>
  import { toggleMute, playSound } from "@lib/audio-manager";
  
  function initSoundToggle() {
    const btn = document.getElementById("sound-button");
    if (btn && !btn.hasAttribute("data-listener-added")) {
      btn.addEventListener("click", () => {
        const isMuted = toggleMute();
        if (!isMuted) {
           playSound("toggle_on");
        }
      });
      btn.setAttribute("data-listener-added", "true");
    }
  }

  document.addEventListener("DOMContentLoaded", initSoundToggle);
  document.addEventListener("astro:after-swap", initSoundToggle);
</script>

<style>
  /* Shared backdrop for the header's pills: readable over the ASCII and content. */
  .header-pill {
    background: rgb(255 247 237 / 0.78);
    border: 1px solid rgb(0 0 0 / 0.08);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  :global(html.dark) .header-pill {
    background: rgb(2 6 23 / 0.78);
    border-color: rgb(255 255 255 / 0.1);
  }
  a.header-pill:hover {
    background: rgb(255 247 237 / 0.95);
  }
  :global(html.dark) a.header-pill:hover {
    background: rgb(2 6 23 / 0.95);
  }
  .nav-link {
    opacity: 0.75;
    transition:
      opacity 0.3s ease,
      color 0.3s ease;
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-current {
    opacity: 1;
  }
  .nav-link.is-current {
    color: rgb(var(--color-accent));
  }
  .nav-dot {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: currentColor;
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nav-link:hover .nav-dot,
  .nav-link.is-current .nav-dot {
    transform: scale(1);
  }
  .sun-moon {
    --duration: 500ms;
    --ease-elastic: cubic-bezier(0.5, 1.25, 0.75, 1.25);
  }
  .sun-moon .moon-mask circle {
    transition: cx var(--duration) var(--ease-elastic), cy var(--duration) var(--ease-elastic), transform var(--duration) var(--ease-elastic);
  }
  :global(.dark) .sun-moon .moon-mask circle {
    cx: 17;
    cy: 11;
    transform: translateX(-7px) translateY(1px); /* fallback for browsers not supporting cx transition */
  }
  @supports (cx: 17) {
    :global(.dark) .sun-moon .moon-mask circle {
      transform: none;
    }
  }
  .sun-moon .sun-core {
    transition: transform var(--duration) var(--ease-elastic);
    transform-origin: center;
  }
  :global(.dark) .sun-moon .sun-core {
    transform: scale(1.75);
  }
  .sun-moon .sun-beams {
    transition: transform var(--duration) var(--ease-elastic), opacity var(--duration) ease-in-out;
    transform-origin: center;
  }
  :global(.dark) .sun-moon .sun-beams {
    transform: rotate(-45deg);
    opacity: 0;
  }

  /* Sound Toggle Animations */
  .sound-icon .sound-waves {
    transition: opacity var(--duration) ease-in-out, transform var(--duration) var(--ease-elastic);
    transform-origin: center;
  }
  .sound-icon .sound-cross-1, .sound-icon .sound-cross-2 {
    transition: opacity var(--duration) ease-in-out, transform var(--duration) var(--ease-elastic);
    transform-origin: 18px 12px;
    opacity: 0;
    transform: scale(0.5) rotate(-45deg);
  }
  
  :global(.muted) .sound-icon .sound-waves {
    opacity: 0;
    transform: translateX(-5px) scale(0.5);
  }
  :global(.muted) .sound-icon .sound-cross-1,
  :global(.muted) .sound-icon .sound-cross-2 {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
</style>

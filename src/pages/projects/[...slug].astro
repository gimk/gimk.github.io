---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageIntro from "@components/stage/PageIntro.astro";
import { readingTime } from "@lib/utils";
import { fieldAt } from "@lib/ascii/stage";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project, i) => ({
    params: { slug: project.id },
    // The next (older) project, wrapping around to the newest.
    props: {
      project,
      next: projects[(i + 1) % projects.length],
      field: fieldAt(i),
      nextField: fieldAt((i + 1) % projects.length),
    },
  }));
}
type Props = { project: CollectionEntry<"projects">; next: CollectionEntry<"projects">; field: string; nextField: string };

const { project, next, field, nextField } = Astro.props;
const { Content } = await render(project);
const date = project.data.date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
---

<PageLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.ogImage}
  type="article"
 
 
>
  <canvas class="ascii-stage" aria-hidden="true" transition:persist="ascii-stage"></canvas>
  <div
    id="project-page"
    class="mx-auto max-w-screen-xl px-5 md:px-10"
    data-id={project.id}
    data-field={field}
    data-next-field={nextField}
    data-thumb={project.data.thumbnail}
    data-next-id={next.id}
    data-next-thumb={next.data.thumbnail}
  >
    <PageIntro
      id="project-intro"
      tall
      back={{ href: "/projects", label: "Projects" }}
      label={`${date} — ${readingTime(project.body)}`}
      title={project.data.title}
      description={project.data.description}
    >
      {
        (project.data.demoURL || project.data.repoURL) && (
          <div data-reveal data-edge class="flex flex-wrap gap-3 mt-3" style="--i:4">
            {project.data.demoURL && (
              <a href={project.data.demoURL} target="_blank" rel="noopener" class="font-mono sp-link cta-pill">
                {project.data.demoLabel || "Visit site"} <span aria-hidden="true">↗</span>
              </a>
            )}
            {project.data.repoURL && (
              <a href={project.data.repoURL} target="_blank" rel="noopener" class="font-mono sp-link cta-pill">
                {project.data.repoLabel || "More info"} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )
      }
    </PageIntro>

    <div id="project-body" class="reading-body mx-auto max-w-3xl pb-[20vh]">
      <article>
        <Content />
      </article>
    </div>

    <!-- Next project: the stage morphs into its image as it arrives. -->
    <section id="project-next" class="relative pt-[45svh] md:pt-[30vh]">
      <a href={`/projects/${next.id}`} class="link-row flex flex-col gap-6 md:w-1/2 py-10">
        <span data-edge class="eyebrow">Next project</span>
        <span data-edge class="display text-5xl md:text-7xl leading-[0.98]">
          {next.data.title}
        </span>
        <span data-edge class="max-w-md font-serif text-xl leading-snug opacity-80">{next.data.description}</span>
        <span data-edge class="font-mono sp-link cta-pill self-start mt-3">
          Read the case study <span aria-hidden="true">→</span>
        </span>
      </a>
    </section>
  </div>
</PageLayout>

<script>
  import {
    onPage,
    createStage,
    side,
    sideFocus,
    PROJECT_LOOK,
    scrollProgress,
    docTop,
    edgeBlur,
    type Anchor,
  } from "@lib/ascii/stage";
  import type { AsciiState } from "@lib/ascii/types";

  onPage("#project-page", () => {
    const page = document.getElementById("project-page")!;
    const canvas = document.querySelector<HTMLCanvasElement>(".ascii-stage")!;
    const body = document.getElementById("project-body")!;
    const next = document.getElementById("project-next")!;
    const { id = "", thumb = "", nextId = "", nextThumb = "", field = "wave", nextField = "wave" } = page.dataset;

    const stage = createStage(canvas);
    const { engine } = stage;
    stage.addProjectImage("this", thumb, id);
    stage.addProjectImage("next", nextThumb, nextId);

    const states: AsciiState[] = [
      // The project's image, as on the home page.
      { id: "this", field, shape: "this", frame: side, focus: sideFocus, intensity: 1, ...PROJECT_LOOK },
      // Reading: the stage steps back almost entirely.
      { id: "read", field: "calm", shape: null, frame: side, focus: sideFocus, intensity: 0.08, ambient: 0.6 },
      // The next project arrives.
      { id: "next", field: nextField, shape: "next", frame: side, focus: sideFocus, intensity: 1, ...PROJECT_LOOK },
    ];
    engine.setStates(states);

    let anchors: Anchor[] = [];
    function measure() {
      const vh = innerHeight;
      anchors = [
        { y: 0, win: [0.35, 1] },
        { y: docTop(body) + vh * 0.1, win: [0.5, 1] },
        // Fully formed at the bottom of the page, where the footer follows it.
        { y: Math.min(docTop(next) + next.offsetHeight / 2 - vh / 2, document.documentElement.scrollHeight - vh), win: [0, 1] },
      ];
    }
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(document.body);

    // The article itself never blurs: only the opening and closing blocks do.
    const blur = edgeBlur([...page.querySelectorAll<HTMLElement>("[data-edge]")], engine.reducedMotion);

    engine.target = scrollProgress(anchors);
    engine.settle();
    engine.start();

    let raf = 0;
    let lastY = scrollY;
    let lastT = performance.now();
    function frame(now: number) {
      const dt = Math.max(1, now - lastT) / 1000;
      engine.velocity += ((scrollY - lastY) / dt - engine.velocity) * 0.15;
      lastY = scrollY;
      lastT = now;
      engine.target = scrollProgress(anchors);
      blur();
      raf = requestAnimationFrame(frame);
    }
    raf = requestAnimationFrame(frame);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      stage.destroy();
    };
  });
</script>

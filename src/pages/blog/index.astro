---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageIntro from "@components/stage/PageIntro.astro";
import { readingTime } from "@lib/utils";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const grouped = data.reduce((acc: Record<string, CollectionEntry<"blog">[]>, post) => {
  const year = post.data.date.getFullYear().toString();
  (acc[year] ??= []).push(post);
  return acc;
}, {});
const years = Object.keys(grouped).sort((a, b) => parseInt(b) - parseInt(a));
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "2-digit", month: "short" });
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <canvas class="ascii-stage" aria-hidden="true"></canvas>
  <div id="blog-page" class="mx-auto max-w-screen-xl px-5 md:px-10">
    <PageIntro
      back={{ href: "/", label: "Home" }}
      align="right"
      label={`Writing — ${data.length} posts`}
      title="Writing"
      description="Notes on design, code and the things in between."
    />

    <div id="blog-list" class="md:w-1/2 md:ml-auto flex flex-col items-end text-right pb-[25vh]">
      {
        years.map((year) => (
          <section class="w-full flex flex-col items-end mb-16">
            <h2 data-edge class="display text-6xl leading-none opacity-30">
              {year}
            </h2>
            <ul class="w-full flex flex-col items-end mt-8">
              {grouped[year].map((post, i) => (
                <li class="w-full flex flex-col items-end">
                  {i > 0 && <span class="block w-10 h-px bg-current opacity-20 my-4" aria-hidden="true" />}
                  <a href={`/blog/${post.id}`} class="link-row blog-row flex flex-col items-end py-10 w-full">
                    <span data-edge class="eyebrow text-[10px]">
                      {fmt(post.data.date)} <span class="mx-2 opacity-60">·</span> {readingTime(post.body ?? "")}
                    </span>
                    <span data-edge class="display mt-5 text-4xl md:text-5xl leading-[1.1]">
                      <span class="link-title">{post.data.title}</span>
                    </span>
                    <span data-edge class="mt-5 max-w-md font-serif text-lg leading-relaxed opacity-70">
                      {post.data.description}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</PageLayout>

<script>
  import {
    onPage,
    createStage,
    sideLeft,
    sideFocusLeft,
    PLAYLIST,
    scrollProgress,
    docTop,
    edgeBlur,
    type Anchor,
  } from "@lib/ascii/stage";
  import type { AsciiState } from "@lib/ascii/types";

  onPage("#blog-page", () => {
    const page = document.getElementById("blog-page")!;
    const list = document.getElementById("blog-list")!;
    const canvas = document.querySelector<HTMLCanvasElement>(".ascii-stage")!;

    const stage = createStage(canvas);
    const { engine } = stage;
    const states: AsciiState[] = [
      { id: "intro", field: "wave", fields: PLAYLIST, period: 6, accent: 0.8, shape: null, frame: sideLeft, focus: sideFocusLeft, intensity: 1, ambient: 1 },
      { id: "list", field: "calm", shape: null, frame: sideLeft, focus: sideFocusLeft, intensity: 0.45, ambient: 0.9 },
    ];
    engine.setStates(states);

    let anchors: Anchor[] = [];
    function measure() {
      anchors = [{ y: 0, win: [0.2, 1] }, { y: Math.max(1, docTop(list) - innerHeight * 0.2), win: [0, 1] }];
    }
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(document.body);

    const blur = edgeBlur([...page.querySelectorAll<HTMLElement>("[data-edge]")], engine.reducedMotion);
    engine.target = scrollProgress(anchors);
    engine.settle();
    engine.start();

    let raf = 0;
    let lastY = scrollY;
    let lastT = performance.now();
    function frame(now: number) {
      const dt = Math.max(1, now - lastT) / 1000;
      engine.velocity += ((scrollY - lastY) / dt - engine.velocity) * 0.15;
      lastY = scrollY;
      lastT = now;
      engine.target = scrollProgress(anchors);
      blur();
      raf = requestAnimationFrame(frame);
    }
    raf = requestAnimationFrame(frame);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      stage.destroy();
    };
  });
</script>

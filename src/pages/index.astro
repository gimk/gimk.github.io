---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import HomeOutro from "@components/home/HomeOutro.astro";
import ExperienceCounter from "@components/ExperienceCounter.astro";
import { SOCIALS, HOME } from "@consts";

/** Featured projects, in scroll order, with their motion field and fallback icon. */
const FEATURED = [
  { id: "comp-studio", kind: "Tool · Design & code", field: "interference", icon: "comp" },
  { id: "colors-studio", kind: "Tool · Design & code", field: "plasma", icon: "colors" },
  { id: "vibe-coding-trilogy", kind: "Site · Photography", field: "vortex", icon: "photo" },
];

const all = await getCollection("projects");
const published = all.filter((p) => !p.data.draft);
const projectCount = published.length;
/** Everything not featured, newest first, for the closing "more" card. */
const others = published
  .filter((p) => !FEATURED.some((f) => f.id === p.id.toLowerCase()))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const projects = FEATURED.map((f) => {
  const entry = all.find((p) => p.id.toLowerCase() === f.id);
  if (!entry) throw new Error(`Missing project ${f.id}`);
  return { ...f, entry };
});
const pad = (n: number) => String(n).padStart(2, "0");
/** Scroll per project inside the pinned scene, in viewport heights. */
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <script is:inline>
    try {
      const force = new URLSearchParams(location.search).has("boot");
      if (force || !localStorage.getItem("gimk:booted")) document.documentElement.dataset.boot = "1";
    } catch (e) {
      // Storage unavailable: no boot.
    }
  </script>

  <canvas class="ascii-stage" aria-hidden="true" transition:persist="ascii-stage"></canvas>

  <div class="mx-auto max-w-screen-xl px-5 md:px-10">
    <!-- Hero -->
    <section id="hero" class="relative min-h-[calc(100svh-6rem)] flex items-end md:items-center pb-[13svh] md:pb-20">
      <div class="md:w-1/2 flex flex-col gap-7 relative z-10">
        <div id="boot-lines" class="font-mono text-xs text-accent-primary leading-6 min-h-12" aria-hidden="true">
          <p id="boot-1" data-text="> init pantoine.com"></p>
          <p id="boot-2" data-text="> loading projects"></p>
          <span id="boot-caret" class="boot-caret">▍</span>
        </div>
        <h1
          data-intro
          data-edge
          class="display text-4xl md:text-5xl leading-none"
        >
          Hi, I'm Antoine.
        </h1>
        <p data-intro data-edge class="max-w-md font-serif text-lg md:text-2xl leading-snug text-ink/80">
          A Creative Engineer and Senior Product Designer, with <span class="hero-counter"><ExperienceCounter /></span>{" "}
          of experience bridging product, design and code.
        </p>
        <p data-intro data-edge class="max-w-sm font-serif text-[15px] md:text-base leading-relaxed opacity-70">
          Also a photographer, a foodie with a French culinary license, and lately building my own tools with AI.
        </p>
        <ul data-intro data-edge class="flex flex-wrap items-center font-mono text-[10px] uppercase tracking-[0.2em]">
          {
            SOCIALS.map((s, i) => (
              <li class="flex items-center">
                {i > 0 && <span class="opacity-40 mx-3" aria-hidden="true">/</span>}
                <a href={s.HREF} target="_blank" rel="noopener" class="opacity-70 hover:opacity-100 hover:text-accent-primary transition-colors">
                  {s.NAME}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p data-intro class="scroll-cue hidden md:block absolute bottom-6 left-0 font-mono text-[10px] uppercase tracking-[0.3em] opacity-50">
        Scroll
      </p>
    </section>

    <!--
      Projects: the ASCII stage stays fixed while the text scrolls natively past
      it; the stage morphs to whichever project is nearest the centre.
    -->
    <section id="scene" class="relative" aria-label="Selected projects">
      <!-- Overlay pinned for the whole section: index and phone rail. -->
      <div class="sticky top-0 h-[100svh] -mb-[100svh] pointer-events-none z-10">
        <nav
          id="project-index"
          class="hidden md:flex absolute right-6 top-1/2 -translate-y-1/2 flex-col items-end gap-3 font-mono text-[10px] tracking-[0.2em] pointer-events-auto"
          aria-label="Projects"
        >
          {
            projects.map(({ entry }, i) => (
              <button type="button" data-index={i} class="pi-item flex items-center gap-3" aria-label={entry.data.title} title={entry.data.title}>
                <span>{pad(i + 1)}</span>
                <span class="pi-bar" aria-hidden="true" />
              </button>
            ))
          }
        </nav>
        <div id="rail" class="md:hidden absolute left-0 bottom-[10svh] opacity-0 flex items-center gap-4 font-mono text-[10px] tracking-[0.2em]" aria-hidden="true">
          <span id="rail-index" class="text-accent-primary">01</span>
          <span class="relative block w-32 h-px bg-ink/15 overflow-hidden">
            <span id="rail-fill" class="absolute inset-0 bg-accent-primary origin-left" style="transform: scaleX(0)"></span>
          </span>
          <span class="opacity-50">{pad(projects.length)}</span>
        </div>
      </div>
      {
        projects.map(({ entry, kind, field, icon }, i) => (
          <div
            data-project
            data-thumb={entry.data.thumbnail}
            data-field={field}
            data-icon={icon}
            class="scene-project relative h-[85svh] w-full md:w-1/2 md:ml-[50%] md:pl-12 md:pr-28 flex flex-col justify-end pb-[10svh] md:justify-center md:pb-0"
          >
            <a href={`/projects/${entry.id}`} class="link-row flex flex-col py-6">
              <span data-edge class="eyebrow">
                {pad(i + 1)} — {entry.data.date.getFullYear()} — {kind}
              </span>
              <h2 data-edge class="mt-6 display text-5xl md:text-7xl leading-[1.02]">
                {entry.data.title}
              </h2>
              <p data-edge class="mt-6 max-w-md font-serif text-lg leading-relaxed opacity-80">{entry.data.description}</p>
              <span data-edge class="font-mono sp-link cta-pill mt-10 self-start">
                Read the case study <span aria-hidden="true">→</span>
              </span>
            </a>
          </div>
        ))
      }
      <!-- The rest of the work: closes the sequence like a project would. -->
      <div
        id="more-projects"
        class="scene-project relative h-[85svh] w-full md:w-1/2 md:ml-[50%] md:pl-12 md:pr-28 flex flex-col justify-end pb-[10svh] md:justify-center md:pb-0"
      >
        <span data-edge class="eyebrow">
          {pad(projects.length + 1)} — Archive
        </span>
        <h2 data-edge class="mt-6 display text-5xl md:text-7xl leading-[0.95]">
          And {others.length} more.
        </h2>
        <ul data-edge class="mt-6 max-w-md font-serif text-lg leading-relaxed opacity-80">
          {
            others.map((p, i) => (
              <li class="inline">
                <a href={`/projects/${p.id}`} class="underline decoration-ink/20 underline-offset-4 hover:text-accent-primary hover:decoration-current transition-colors">{p.data.title}</a>{i < others.length - 1 && <span class="opacity-50">, </span>}
              </li>
            ))
          }
        </ul>
        <a data-edge href="/projects" class="font-mono sp-link cta-pill mt-10 self-start">
          See all {projectCount} projects <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <HomeOutro />
  </div>
</PageLayout>

<style is:global>
  .boot-caret {
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  #boot-1,
  #boot-2 {
    display: inline;
  }
  #boot-2:not(:empty)::before {
    content: "\A";
    white-space: pre;
  }

  [data-intro] {
    transition:
      opacity 1.1s var(--ease-out-soft),
      transform 1.1s var(--ease-out-soft),
      filter 1.1s ease;
  }
  html.edge-live [data-intro][data-edge] {
    transition: none;
  }
  /* Boot lines leave like text scrolling under the header: blur, fade and
     drift up. Then their space closes, so the greeting glides up to centre. */
  #boot-lines {
    max-height: 4rem;
    transition:
      opacity 0.9s ease,
      filter 0.9s ease,
      transform 0.9s var(--ease-out-soft),
      max-height 1s var(--ease-in-out-soft) 0.7s,
      min-height 1s var(--ease-in-out-soft) 0.7s,
      margin-bottom 1s var(--ease-in-out-soft) 0.7s;
  }
  #boot-lines.is-gone {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(-10px);
    max-height: 0;
    min-height: 0;
    margin-bottom: -1.75rem; /* cancels the column's gap-7 */
    overflow: hidden;
  }
  /* Arriving from another page: no boot lines at all, not even briefly. */
  html[data-navigated] #boot-lines {
    display: none;
  }
  html[data-boot] [data-intro]:not(.in) {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(6px);
  }
  .scroll-cue::after {
    content: "";
    display: block;
    width: 1px;
    height: 36px;
    margin-top: 10px;
    background: currentColor;
    transform-origin: top;
    animation: cue 2.4s cubic-bezier(0.6, 0, 0.2, 1) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  .hero-counter #experience-counter {
    font-weight: 400;
    color: rgb(var(--color-accent));
    font-variant-numeric: tabular-nums;
  }
  #project-index {
    opacity: var(--index-o, 0);
    transition: opacity 0.2s linear;
  }
  .pi-item {
    opacity: 0.4;
    transition:
      opacity 0.4s ease,
      color 0.4s ease;
  }
  .pi-item:hover,
  .pi-item:focus-visible {
    opacity: 0.85;
  }
  .pi-item.is-current {
    opacity: 1;
    color: rgb(var(--color-accent));
  }
  .pi-bar {
    display: block;
    height: 1px;
    width: 0.75rem;
    background: currentColor;
    transition: width 0.5s var(--ease-out-soft);
  }
  .pi-item.is-current .pi-bar {
    width: 2.25rem;
  }
  .scene-project {
    opacity: var(--o, 1);
  }
</style>

<script>
  import type { Rgba } from "@lib/ascii/engine";
  import { ICONS } from "@lib/ascii/icons";
  import { iconShape, imageSample, imageShape, type ImageSample } from "@lib/ascii/shapes";
  import type { AsciiState, Rect } from "@lib/ascii/types";
  import { onPage, stageEngine, releaseEngine, side, sideFocus, sideLeft, sideFocusLeft, centre, PLAYLIST } from "@lib/ascii/stage";

  // Runs on every visit, including client-side navigations back to this page.
  onPage("#scene", () => {
  let alive = true;


    const root = document.documentElement;
    const canvas = document.querySelector<HTMLCanvasElement>(".ascii-stage")!;
    const scene = document.getElementById("scene")!;
    const projectEls = [...document.querySelectorAll<HTMLElement>("[data-project]")];
    const moreEl = document.getElementById("more-projects")!;
    const rail = document.getElementById("rail")!;
    const railIndex = document.getElementById("rail-index")!;
    const railFill = document.getElementById("rail-fill")!;
    const experience = document.querySelector<HTMLElement>('[data-anchor="experience"]')!;
    const blog = document.querySelector<HTMLElement>('[data-anchor="blog"]')!;
    const closing = document.querySelector<HTMLElement>('[data-anchor="closing"]')!;
    const booting = root.dataset.boot === "1";

    const engine = stageEngine(canvas);
    // Arriving from another page: the stage is already running, so it travels
    // straight to its place here instead of replaying the opening wave.
    const arriving = engine.carrying || root.dataset.navigated === "1";

    // ---- Theme / inks: muted field, accent shape and peaks ----
    const projectImages: (ImageSample | null)[] = projectEls.map(() => null);
    const isDark = () => root.classList.contains("dark");
    function applyTheme() {
      const accent = getComputedStyle(root).getPropertyValue("--color-accent").trim().split(/\s+/).map(Number);
      const dark = isDark();
      const fieldInk: Rgba = dark ? [255, 255, 255, 0.34] : [20, 20, 20, 0.34];
      const shapeInk: Rgba = [accent[0], accent[1], accent[2], dark ? 0.95 : 1];
      engine.setInks(fieldInk, shapeInk);
      projectImages.forEach((img, i) => {
        if (img) engine.setShape(`project-${i}`, imageShape(img, { lightInk: dark, contrast: 1.3, floor: 0.35, fadeBottom: 0 }));
      });
    }
    const themeObserver = new MutationObserver(applyTheme);
    themeObserver.observe(root, { attributes: true, attributeFilter: ["class"] });

    // ---- Preload the featured projects ----
    // Each project's 3D thumbnail, shaded in ASCII on the stage (the flat icon
    // set is the fallback while it loads or if it fails), and its case study
    // page, fetched into the HTTP cache so opening it is instant. Pages are
    // skipped on Save-Data or 2G connections. The boot's "loading projects"
    // line counts these down.
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const lightweight = !!conn?.saveData || /2g/.test(conn?.effectiveType ?? "");
    let projectsLoaded = 0;
    projectEls.forEach((el, i) => {
      engine.setShape(`project-${i}`, iconShape(ICONS[el.dataset.icon ?? ""] ?? ICONS.blank));
      const thumb = new Promise<void>((resolve) => {
        const img = new Image();
        img.onload = () => {
          projectImages[i] = imageSample(img);
          applyTheme();
          resolve();
        };
        img.onerror = () => resolve();
        img.src = el.dataset.thumb ?? "";
      });
      const href = el.querySelector("a")?.getAttribute("href");
      const page = href && !lightweight ? fetch(href, { priority: "low" } as RequestInit).then(() => {}, () => {}) : null;
      Promise.all([thumb, page]).then(() => projectsLoaded++);
    });
    applyTheme();

    // The opening wave is centred on the terminal caret: it starts as a point
    // there, grows until it fills the screen, then travels into the hero ellipse.
    let origin = { x: innerWidth * 0.2, y: innerHeight * 0.4 };
    const seed = (): Rect => ({ x: origin.x - 1, y: origin.y - 1, w: 2, h: 2 });
    const bloom = (): Rect => {
      const r = Math.hypot(Math.max(origin.x, innerWidth - origin.x), Math.max(origin.y, innerHeight - origin.y)) * 1.15;
      return { x: origin.x - r, y: origin.y - r, w: r * 2, h: r * 2 };
    };

    // ---- States ----
    const states: AsciiState[] = [
      { id: "seed", field: "wave", shape: null, frame: seed, intensity: 1, ambient: 1, accent: 0.8 },
      { id: "bloom", field: "wave", shape: null, frame: bloom, intensity: 0.9, ambient: 1, accent: 0.6 },
      { id: "hero", field: "wave", fields: PLAYLIST, period: 6, shape: null, frame: side, focus: sideFocus, intensity: 1, ambient: 1, accent: 1 },
      ...projectEls.map((el, i) => ({
        id: `project-${i}`,
        field: el.dataset.field ?? "wave",
        shape: `project-${i}`,
        // Projects sit on the left: the stage crosses the page between sections.
        frame: sideLeft,
        focus: sideFocusLeft,
        intensity: 1,
        ambient: 0.75,
        shapeScale: 0.72,
        warp: 0.35,
        texture: 0.5,
      })),
      // "And N more": the field alone, still on the left, closing the sequence.
      { id: "more", field: "cells", shape: null, frame: sideLeft, focus: sideFocusLeft, intensity: 0.8, ambient: 0.9 },
      { id: "experience", field: "calm", shape: null, frame: side, focus: sideFocus, intensity: 0.5, ambient: 0.9 },
      { id: "blog", field: "grid", shape: null, frame: sideLeft, focus: sideFocusLeft, intensity: 0.45, ambient: 0.9 },
      { id: "closing", field: "rings", shape: null, frame: centre, intensity: 0.85, ambient: 1, accent: 0.5 },
    ];
    engine.setStates(states);
    const HERO = 2;
    const FIRST_PROJECT = 3;

    // ---- Scroll → target ----
    // Each anchor is the scrollY where a state (from "hero" on) is fully formed.
    // `win` is the slice of the gap to the next anchor where the morph happens;
    // outside it the state holds.
    interface Anchor {
      y: number;
      win: [number, number];
    }
    let anchors: Anchor[] = [];
    const docTop = (el: Element) => el.getBoundingClientRect().top + scrollY;
    let sceneDocTop = 0;
    function measure() {
      const vh = innerHeight;
      sceneDocTop = docTop(scene);
      const centreOf = (el: HTMLElement) => sceneDocTop + el.offsetTop + el.offsetHeight / 2 - vh / 2;
      anchors = [
        { y: 0, win: [0.15, 0.95] },
        // A project is fully formed when its text is centred on screen; the
        // morph runs while one text leaves and the next arrives.
        ...projectEls.map((el) => ({ y: centreOf(el), win: [0.3, 0.7] as [number, number] })),
        { y: centreOf(moreEl), win: [0.15, 0.7] },
        { y: docTop(experience) - vh * 0.1, win: [0.55, 1] },
        { y: docTop(blog) - vh * 0.1, win: [0.5, 1] },
        { y: docTop(closing), win: [0, 1] },
      ];
    }
    measure();
    addEventListener("resize", measure);
    addEventListener("load", measure);

    function scrollTarget(): number {
      const y = scrollY;
      if (y <= anchors[0].y) return HERO;
      for (let j = 0; j < anchors.length - 1; j++) {
        const a = anchors[j];
        const b = anchors[j + 1];
        if (y < b.y) {
          const f = (y - a.y) / Math.max(1, b.y - a.y);
          const [w0, w1] = a.win;
          return HERO + j + Math.min(1, Math.max(0, (f - w0) / (w1 - w0)));
        }
      }
      return HERO + anchors.length - 1;
    }

    // ---- Project index: smooth-scroll to a project ----
    const projectIndex = document.getElementById("project-index")!;
    const indexItems = [...document.querySelectorAll<HTMLButtonElement>(".pi-item")];
    indexItems.forEach((b) =>
      b.addEventListener("click", () => {
        const i = Number(b.dataset.index);
        scrollTo({ top: anchors[1 + i].y, behavior: engine.reducedMotion ? "auto" : "smooth" });
      }),
    );

    // ---- Keyboard: up/down arrows step between sections, Enter opens the
    // project in view. Other native keys are untouched.
    function onKey(e: KeyboardEvent) {
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey || e.defaultPrevented) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT|A|BUTTON)$/.test(t.tagName))) return;
      const behavior = engine.reducedMotion ? "auto" : "smooth";
      if (e.key === "ArrowDown") {
        const next = anchors.find((a) => a.y > scrollY + 10);
        if (next) scrollTo({ top: next.y, behavior });
      } else if (e.key === "ArrowUp") {
        const prev = [...anchors].reverse().find((a) => a.y < scrollY - 10);
        scrollTo({ top: prev ? prev.y : 0, behavior });
      } else if (e.key === "Enter") {
        const i = Math.round(engine.progress - FIRST_PROJECT);
        const near = Math.abs(engine.progress - FIRST_PROJECT - i) < 0.25;
        const href = near && projectEls[i]?.querySelector("a")?.getAttribute("href");
        if (href) location.href = href;
      } else return;
      e.preventDefault();
    }
    addEventListener("keydown", onKey);

    // ---- Edge blur ----
    // The same blur the hero text arrives with on the boot: text blurs and fades
    // as it slides under the header or towards the bottom of the screen.
    const edgeEls = [...document.querySelectorAll<HTMLElement>("[data-edge]")];
    const edgeState = new Map<HTMLElement, number>();
    let edgeLive = false;
    const header = document.querySelector("header");
    const EDGE_BLUR = 6; // px at the very edge, as in the boot
    function updateEdges() {
      const vh = innerHeight;
      const top = header ? header.offsetHeight : 80;
      const topZone = 110;
      const bottomZone = vh * 0.16;
      // Read everything first, then write, so layout is computed once.
      const values = edgeEls.map((el) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < -50 || r.top > vh + 50) return 1;
        const c = r.top + Math.min(r.height, 120) / 2;
        const t = (top + topZone - c) / topZone;
        const b = (c - (vh - bottomZone)) / bottomZone;
        const e = Math.max(0, Math.min(1, Math.max(t, b)));
        return e * e * (3 - 2 * e);
      });
      edgeEls.forEach((el, i) => {
        const e = Math.round(values[i] * 100) / 100;
        if (edgeState.get(el) === e) return;
        edgeState.set(el, e);
        el.style.filter =
          e <= 0
            ? ""
            : engine.reducedMotion
              ? `opacity(${(1 - e * 0.9).toFixed(2)})`
              : `blur(${(e * EDGE_BLUR).toFixed(2)}px) opacity(${(1 - e * 0.9).toFixed(2)})`;
      });
    }

    // ---- Per-frame sync ----
    let lastY = scrollY;
    let lastT = performance.now();
    let vel = 0;
    let introDone = false;
    let introP = 0;
    /** Text magnetism: 0.55 = moves at 45% of scroll speed when centred. */
    const MAGNET = 0.55;
    const MAGNET_WIDTH = 0.3;

    function frame(now: number) {
      const dt = Math.max(1, now - lastT) / 1000;
      vel += ((scrollY - lastY) / dt - vel) * 0.15;
      lastY = scrollY;
      lastT = now;
      engine.velocity = vel;

      const st = scrollTarget();
      if (!introDone && st > HERO + 0.02) finishIntro();
      if (introDone) {
        // The stage follows the scroll exactly: stop mid-morph and it stays mid-morph.
        engine.target = st;
      } else {
        // The opening is time-driven and exact: no spring lag.
        engine.target = introP;
        engine.settle();
      }

      const p = engine.progress;
      // The nearest project, even mid-morph.
      const active = Math.max(0, Math.min(projectEls.length - 1, Math.round(p - FIRST_PROJECT)));
      // Text scrolls natively, with a little magnetism: near the middle of the
      // screen it moves slower than the scroll, then catches up further out.
      // Purely visual; the scroll position itself is never touched.
      const vh = innerHeight;
      let indexO = 0;
      [...projectEls, moreEl].forEach((el) => {
        // Layout position (ignores our own transform).
        const top = sceneDocTop + el.offsetTop - scrollY;
        if (top + el.offsetHeight < -vh || top > 2 * vh) return;
        const o = (top + el.offsetHeight / 2 - vh / 2) / vh; // 0 = centred
        const pull = engine.reducedMotion ? 0 : -MAGNET * o * Math.exp(-((o / MAGNET_WIDTH) ** 2));
        el.style.transform = `translate3d(0, ${(pull * vh).toFixed(2)}px, 0)`;
        const off = Math.abs(o + pull);
        const o2 = Math.max(0, Math.min(1, 1 - (off - 0.2) / 0.35));
        el.style.setProperty("--o", o2.toFixed(3));
        if (el !== moreEl) indexO = Math.max(indexO, o2);
      });
      // The index arrives and leaves with the project text, not with the section edge.
      projectIndex.style.setProperty("--index-o", indexO.toFixed(3));
      projectIndex.style.pointerEvents = indexO > 0.3 ? "auto" : "none";
      // The phone rail follows the project text too: gone after the last project.
      rail.style.opacity = indexO.toFixed(3);
      railIndex.textContent = String(active + 1).padStart(2, "0");
      const inScene = p > FIRST_PROJECT - 0.5 && p < FIRST_PROJECT + projectEls.length - 0.5;
      indexItems.forEach((b, i) => b.classList.toggle("is-current", inScene && i === active));
      const rp = (p - FIRST_PROJECT) / Math.max(1, projectEls.length - 1);
      railFill.style.transform = `scaleX(${Math.max(0, Math.min(1, rp)).toFixed(4)})`;
      if (edgeLive) updateEdges();
      if (alive) requestAnimationFrame(frame);
    }

    // ---- Opening ----
    const intros = [...document.querySelectorAll<HTMLElement>("[data-intro]")];
    const caret = document.getElementById("boot-caret")!;
    const lines = [document.getElementById("boot-1")!, document.getElementById("boot-2")!];
    let typing = false;

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    function caretPoint() {
      const r = caret.getBoundingClientRect();
      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }
    function fillLines() {
      for (const l of lines) l.textContent = l.dataset.text ?? "";
      lines[1].after(caret);
    }
    /** Show each intro element as the growing wave reaches it. */
    function showTextAsWavePasses(bloomMs: number) {
      const r = bloom().w / 2;
      for (const el of intros) {
        const b = el.getBoundingClientRect();
        const d = Math.hypot(b.left + 24 - origin.x, b.top + b.height / 2 - origin.y);
        // Invert the bloom's ease-out to find when its edge reaches distance d.
        const frac = Math.min(0.999, d / (r * 0.75));
        const t = 1 - Math.cbrt(1 - frac);
        setTimeout(() => el.classList.add("in"), t * bloomMs + 80);
      }
    }

    let raf = 0;
    /** seed → bloom (the wave grows out of the caret) → hero (it travels into the ellipse and starts cycling). */
    function playWave(bloomMs: number, morphMs: number) {
      origin = caretPoint();
      showTextAsWavePasses(bloomMs);
      const t0 = performance.now();
      const step = (now: number) => {
        const e = now - t0;
        if (e < bloomMs) introP = easeOut(e / bloomMs);
        else {
          // The wave starts travelling into the side ellipse.
          if (introP < 1) hideBootLines();
          introP = 1 + easeInOut(Math.min(1, (e - bloomMs) / morphMs));
        }
        if (introP < 2) raf = requestAnimationFrame(step);
        else {
          introDone = true;
          afterIntro();
        }
      };
      raf = requestAnimationFrame(step);
    }

    function finishIntro() {
      if (introDone) return;
      typing = false;
      cancelAnimationFrame(raf);
      fillLines();
      introDone = true; // the spring carries the stage from wherever it is to the hero
      intros.forEach((el) => el.classList.add("in"));
      afterIntro();
    }
    /**
     * The terminal lines have done their job once the wave heads to the right:
     * they blur away, then their space closes so the greeting settles in the centre.
     */
    function hideBootLines() {
      document.getElementById("boot-lines")?.classList.add("is-gone");
    }
    /** Runs once, however the intro ended (played through or skipped). */
    let afterIntroDone = false;
    function afterIntro() {
      if (afterIntroDone) return;
      afterIntroDone = true;
      // Once the text has arrived, the edge blur takes over its filter.
      setTimeout(() => {
        root.classList.add("edge-live");
        edgeLive = true;
      }, 1200);
      hideBootLines();
    }

    async function typeLine(el: HTMLElement, cps: number) {
      const text = el.dataset.text ?? "";
      el.after(caret);
      for (let i = 1; i <= text.length && typing; i++) {
        el.textContent = text.slice(0, i);
        await sleep(1000 / cps + Math.random() * 30);
      }
    }

    async function boot() {
      try {
        localStorage.setItem("gimk:booted", "1");
      } catch {}
      if (engine.reducedMotion) {
        origin = caretPoint();
        return finishIntro();
      }
      for (const ev of ["keydown", "pointerdown", "wheel", "touchstart"]) {
        addEventListener(ev, finishIntro, { once: true, passive: true });
      }
      typing = true;
      await sleep(350);
      await typeLine(lines[0], 22);
      await sleep(260);
      await typeLine(lines[1], 30);
      // One dot per featured project, as each one actually finishes loading,
      // but never holding the opening back for more than a moment.
      const cap = performance.now() + 1800;
      for (let i = 0; i < projectEls.length && typing; i++) {
        await sleep(180);
        while (projectsLoaded <= i && typing && performance.now() < cap) await sleep(50);
        lines[1].textContent += ".";
      }
      if (introDone) return;
      await sleep(220);
      playWave(1500, 2200);
    }

    engine.start();
    requestAnimationFrame(frame);
    if (booting && !arriving) {
      boot();
    } else {
      // Returning visitors: no typing, a quicker wave.
      fillLines();
      if (scrollY > 10 || engine.reducedMotion || arriving) {
        origin = caretPoint();
        finishIntro();
        engine.target = scrollTarget();
        engine.settle();
      } else {
        playWave(800, 1300);
      }
    }

    // Leaving the page (client-side navigation): stop everything.
    return () => {
      alive = false;
      typing = false;
      cancelAnimationFrame(raf);
      releaseEngine(engine);
      themeObserver.disconnect();
      removeEventListener("resize", measure);
      removeEventListener("load", measure);
      removeEventListener("keydown", onKey);
      for (const ev of ["keydown", "pointerdown", "wheel", "touchstart"]) removeEventListener(ev, finishIntro);
    };

  });
</script>

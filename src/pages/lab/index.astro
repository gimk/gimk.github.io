---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import LabOutro from "@components/lab/LabOutro.astro";

/** Featured projects, in scroll order. Icon + motion field live in the script's LOOKS. */
const FEATURED = [
  { id: "comp-studio", kind: "Tool · Design & code" },
  { id: "dither-studio", kind: "Tool · Design & code" },
  { id: "colors-studio", kind: "Tool · Design & code" },
  { id: "vibe-coding-trilogy", kind: "Site · Photography" },
  { id: "bankin-year-2", kind: "Product design · Bankin'" },
  { id: "future-of-coach", kind: "Product design · Younited" },
];

const all = await getCollection("projects");
const projects = FEATURED.map((f) => {
  const entry = all.find((p) => p.id.toLowerCase() === f.id);
  if (!entry) throw new Error(`Missing project ${f.id}`);
  return { ...f, entry };
});
const pad = (n: number) => String(n).padStart(2, "0");
/** Scroll per project inside the pinned scene, in viewport heights. */
const STEP = 1.5;
/** Scene height: STEP per project, plus a hold at the end. */
const sceneHeight = ((projects.length - 1) * STEP + 1.6) * 100;
---

<PageLayout title="Lab" description="ASCII stage prototype" asciiBackground={false} bareHeader>
  <script is:inline>
    try {
      const force = new URLSearchParams(location.search).has("boot");
      if (force || !localStorage.getItem("gimk:booted")) document.documentElement.dataset.boot = "1";
    } catch (e) {}
  </script>

  <canvas id="ascii-stage" aria-hidden="true"></canvas>

  <div class="mx-auto max-w-screen-xl px-5 md:px-10">
    <!-- Hero -->
    <section id="hero" class="relative min-h-[calc(100svh-6rem)] flex items-center">
      <div class="md:w-1/2 flex flex-col gap-10 relative z-10">
        <div class="font-mono text-xs text-accent-primary leading-6 min-h-12" aria-hidden="true">
          <p id="boot-1" data-text="> init gimk.portfolio"></p>
          <p id="boot-2" data-text="> loading fields"></p>
          <span id="boot-caret" class="boot-caret">▍</span>
        </div>
        <h1
          data-intro
          class="!font-serif font-normal text-6xl md:text-8xl tracking-tight leading-[0.92] text-black dark:text-white"
        >
          Antoine<br />Pouligny
        </h1>
        <p data-intro class="font-mono text-xs uppercase tracking-[0.2em] opacity-60">
          Creative Engineer — Senior Product Designer
        </p>
        <p data-intro class="max-w-sm font-serif text-lg leading-relaxed opacity-80">
          I merge design and engineering to build clear, simple and meaningful user systems.
        </p>
      </div>
      <div id="hero-frame" class="md:hidden absolute inset-x-0 top-0 h-[45vh] -z-10" aria-hidden="true"></div>
      <p data-intro class="scroll-cue absolute bottom-6 left-0 font-mono text-[10px] uppercase tracking-[0.3em] opacity-50">
        Scroll
      </p>
    </section>

    <!-- Projects: one pinned scene; text and icon change together -->
    <section
      id="scene"
      class="relative"
      style={`height: ${sceneHeight}svh`}
      data-step={STEP}
      aria-label="Selected projects"
    >
      <div id="scene-pin" class="sticky top-0 h-[100svh] flex items-center">
        <div class="relative w-full h-[70svh]">
          {
            projects.map(({ entry, kind }, i) => (
              <div
                data-project
                data-thumb={entry.data.thumbnail}
                class="scene-project absolute inset-y-0 left-0 w-full md:w-1/2 md:left-1/2 md:pl-12 flex flex-col justify-center"
                style="--d:1;--o:0"
              >
                <span class="sp-mask">
                  <span class="sp-line font-mono text-xs uppercase tracking-[0.2em] opacity-50" style="--i:0">
                    {pad(i + 1)} — {entry.data.date.getFullYear()} — {kind}
                  </span>
                </span>
                <span class="sp-mask mt-6">
                  <h2
                    class="sp-line !font-serif font-normal text-5xl md:text-7xl tracking-tight leading-[0.95] text-black dark:text-white"
                    style="--i:1"
                  >
                    {entry.data.title}
                  </h2>
                </span>
                <span class="sp-mask mt-6">
                  <span class="sp-line max-w-md font-serif text-lg leading-relaxed opacity-80" style="--i:2">
                    {entry.data.description}
                  </span>
                </span>
                <span class="sp-mask mt-10">
                  <a
                    href={`/projects/${entry.id}`}
                    class="sp-line sp-link font-mono text-xs uppercase tracking-[0.2em] text-accent-primary"
                    style="--i:3"
                  >
                    Read the case study <span aria-hidden="true">→</span>
                  </a>
                </span>
              </div>
            ))
          }
        </div>
        <!-- Index: jump straight to a project (desktop). -->
        <nav
          id="project-index"
          class="hidden md:flex absolute left-[calc(50%+3rem)] bottom-[7svh] flex-col gap-2 font-mono text-[10px] uppercase tracking-[0.2em]"
          aria-label="Projects"
        >
          {
            projects.map(({ entry }, i) => (
              <button type="button" data-index={i} class="pi-item flex items-center gap-3 text-left">
                <span class="pi-bar" aria-hidden="true" />
                <span class="opacity-60">{pad(i + 1)}</span>
                <span>{entry.data.title}</span>
              </button>
            ))
          }
        </nav>
        <!-- Compact rail on phones. -->
        <div id="rail" class="md:hidden absolute left-0 bottom-[10svh] flex items-center gap-4 font-mono text-[10px] tracking-[0.2em]" aria-hidden="true">
          <span id="rail-index" class="text-accent-primary">01</span>
          <span class="relative block w-32 h-px bg-black/15 dark:bg-white/15 overflow-hidden">
            <span id="rail-fill" class="absolute inset-0 bg-accent-primary origin-left" style="transform: scaleX(0)"></span>
          </span>
          <span class="opacity-50">{pad(projects.length)}</span>
        </div>
      </div>
    </section>

    <LabOutro />
  </div>
</PageLayout>

<style is:global>
  #ascii-stage {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
  }
  .boot-caret {
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  #boot-1,
  #boot-2 {
    display: inline;
  }
  #boot-2:not(:empty)::before {
    content: "\A";
    white-space: pre;
  }

  [data-intro] {
    transition:
      opacity 1.1s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 1.1s ease;
  }
  html[data-boot] [data-intro]:not(.in) {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(6px);
  }
  .scroll-cue::after {
    content: "";
    display: block;
    width: 1px;
    height: 36px;
    margin-top: 10px;
    background: currentColor;
    transform-origin: top;
    animation: cue 2.4s cubic-bezier(0.6, 0, 0.2, 1) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* Pinned project scene. --d: -1 upcoming, 0 active, 1 gone (from the stage's smoothed progress). */
  .pi-item {
    opacity: 0.4;
    transition:
      opacity 0.4s ease,
      color 0.4s ease;
  }
  .pi-item:hover,
  .pi-item:focus-visible {
    opacity: 0.85;
  }
  .pi-item.is-current {
    opacity: 1;
    color: rgb(var(--color-accent));
  }
  .pi-bar {
    display: block;
    height: 1px;
    width: 0.75rem;
    background: currentColor;
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pi-item.is-current .pi-bar {
    width: 2.25rem;
  }
  .scene-project {
    pointer-events: none;
    opacity: var(--o);
  }
  .scene-project.is-active {
    pointer-events: auto;
  }
  .sp-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
  }
  .sp-line {
    display: block;
    will-change: transform;
    transform: translateY(calc(clamp(-1, var(--d) * (1 + var(--i) * 0.35), 1) * -110%));
  }
  .sp-link span {
    display: inline-block;
    transition: transform 0.3s ease;
  }
  .sp-link:hover span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-intro],
    .boot-caret,
    .scroll-cue::after {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { AsciiEngine, type Rgba } from "@lib/ascii/engine";
  import { ICONS } from "@lib/ascii/icons";
  import { iconShape, imageSample, imageShape, type ImageSample } from "@lib/ascii/shapes";
  import type { AsciiState, Rect } from "@lib/ascii/types";

  /** Motion field per featured project, same order as the markup. */
  const FIELDS_BY_PROJECT = ["interference", "grid", "plasma", "vortex", "rings", "cells"];
  /** The hero cycles through the original animations, each blending into the next. Starts on "wave" so the opening wave flows straight into it. */
  const HERO_PLAYLIST = ["wave", "vortex", "interference", "plasma", "tunnel", "rings", "solar", "cells", "grid"];

  const root = document.documentElement;
  const canvas = document.getElementById("ascii-stage") as HTMLCanvasElement;
  const heroFrame = document.getElementById("hero-frame")!;
  const scene = document.getElementById("scene")!;
  const projectEls = [...document.querySelectorAll<HTMLElement>("[data-project]")];
  const railIndex = document.getElementById("rail-index")!;
  const railFill = document.getElementById("rail-fill")!;
  const experience = document.querySelector<HTMLElement>('[data-anchor="experience"]')!;
  const closing = document.querySelector<HTMLElement>('[data-anchor="closing"]')!;
  const booting = root.dataset.boot === "1";
  const STEP = Number(scene.dataset.step) || 1.5;

  const engine = new AsciiEngine({ canvas, fontSize: 10 });

  // ---- Theme / inks: muted field, accent shape and peaks ----
  const projectImages: (ImageSample | null)[] = projectEls.map(() => null);
  const isDark = () => root.classList.contains("dark");
  function applyTheme() {
    const accent = getComputedStyle(root).getPropertyValue("--color-accent").trim().split(/\s+/).map(Number);
    const dark = isDark();
    const fieldInk: Rgba = dark ? [255, 255, 255, 0.34] : [20, 20, 20, 0.34];
    const shapeInk: Rgba = [accent[0], accent[1], accent[2], dark ? 0.95 : 1];
    engine.setInks(fieldInk, shapeInk);
    projectImages.forEach((img, i) => {
      if (img) engine.setShape(`project-${i}`, imageShape(img, { lightInk: dark, contrast: 1.3, floor: 0.35, fadeBottom: 0 }));
    });
  }
  new MutationObserver(applyTheme).observe(root, { attributes: true, attributeFilter: ["class"] });

  // ---- Project illustrations: each project's 3D thumbnail, shaded in ASCII ----
  // The flat icon set is the fallback while an image loads or if it fails.
  const FALLBACK_ICONS = ["comp", "dither", "colors", "photo", "bankin", "coach"];
  projectEls.forEach((el, i) => {
    engine.setShape(`project-${i}`, iconShape(ICONS[FALLBACK_ICONS[i]] ?? ICONS.blank));
    const img = new Image();
    img.onload = () => {
      projectImages[i] = imageSample(img);
      applyTheme();
    };
    img.src = el.dataset.thumb ?? "";
  });
  applyTheme();

  // ---- Frames ----
  const wide = () => innerWidth >= 768;
  const rectOf = (el: Element): Rect => {
    const r = el.getBoundingClientRect();
    return { x: r.left, y: r.top, w: r.width, h: r.height };
  };
  /**
   * Right side: the ellipse is much larger than the screen's right half,
   * runs off the top, bottom and right edges, and its soft left rim reaches
   * a little under the text column.
   */
  const side = (): Rect =>
    wide()
      ? { x: innerWidth * 0.28, y: -innerHeight * 0.35, w: innerWidth * 1.12, h: innerHeight * 1.7 }
      : { x: -innerWidth * 0.1, y: innerHeight * 0.02, w: innerWidth * 1.2, h: innerHeight * 0.42 };
  /** The visible right half, where images and the field's centre sit. */
  const sideFocus = (): Rect =>
    wide() ? { x: innerWidth * 0.5, y: 0, w: innerWidth * 0.5, h: innerHeight } : side();
  /** Mirror images of the above, for the projects. */
  const mirror = (r: Rect): Rect => ({ ...r, x: innerWidth - (r.x + r.w) });
  const sideLeft = (): Rect => (wide() ? mirror(side()) : side());
  const sideFocusLeft = (): Rect => (wide() ? mirror(sideFocus()) : side());
  const heroSide = (): Rect => (wide() ? side() : rectOf(heroFrame));
  const centre = (): Rect => ({ x: innerWidth * 0.08, y: innerHeight * 0.04, w: innerWidth * 0.84, h: innerHeight * 0.92 });

  // The opening wave is centred on the terminal caret: it starts as a point
  // there, grows until it fills the screen, then travels into the hero ellipse.
  let origin = { x: innerWidth * 0.2, y: innerHeight * 0.4 };
  const seed = (): Rect => ({ x: origin.x - 1, y: origin.y - 1, w: 2, h: 2 });
  const bloom = (): Rect => {
    const r = Math.hypot(Math.max(origin.x, innerWidth - origin.x), Math.max(origin.y, innerHeight - origin.y)) * 1.15;
    return { x: origin.x - r, y: origin.y - r, w: r * 2, h: r * 2 };
  };

  // ---- States ----
  const states: AsciiState[] = [
    { id: "seed", field: "wave", shape: null, frame: seed, intensity: 1, ambient: 1, accent: 0.8 },
    { id: "bloom", field: "wave", shape: null, frame: bloom, intensity: 0.9, ambient: 1, accent: 0.6 },
    { id: "hero", field: "wave", fields: HERO_PLAYLIST, period: 6, shape: null, frame: heroSide, focus: () => (wide() ? sideFocus() : heroSide()), intensity: 1, ambient: 1, accent: 1 },
    ...projectEls.map((_, i) => ({
      id: `project-${i}`,
      field: FIELDS_BY_PROJECT[i % FIELDS_BY_PROJECT.length],
      shape: `project-${i}`,
      // Projects sit on the left: the stage crosses the page between sections.
      frame: sideLeft,
      focus: sideFocusLeft,
      intensity: 1,
      ambient: 0.75,
      shapeScale: 0.72,
      warp: 0.35,
      texture: 0.5,
    })),
    { id: "experience", field: "calm", shape: null, frame: side, focus: sideFocus, intensity: 0.5, ambient: 0.9 },
    { id: "closing", field: "rings", shape: null, frame: centre, intensity: 0.85, ambient: 1, accent: 0.5 },
  ];
  engine.setStates(states);
  const HERO = 2;
  const FIRST_PROJECT = 3;

  // ---- Scroll → target ----
  // Each anchor is the scrollY where a state (from "hero" on) is fully formed.
  // `win` is the slice of the gap to the next anchor where the morph happens;
  // outside it the state holds.
  interface Anchor {
    y: number;
    win: [number, number];
  }
  let anchors: Anchor[] = [];
  const docTop = (el: Element) => el.getBoundingClientRect().top + scrollY;
  function measure() {
    const vh = innerHeight;
    const sceneTop = docTop(scene);
    const last = projectEls.length - 1;
    anchors = [
      { y: 0, win: [0.15, 0.95] },
      // Long holds, a short morph in the middle of each gap.
      ...projectEls.map((_, i) => ({
        y: sceneTop + i * STEP * vh,
        // Hold ~80% of the way, morph in the middle 20%.
        win: (i === last ? [0.15, 0.7] : [0.4, 0.6]) as [number, number],
      })),
      { y: docTop(experience) - vh * 0.1, win: [0.55, 1] },
      { y: docTop(closing), win: [0, 1] },
    ];
  }
  measure();
  addEventListener("resize", measure);
  addEventListener("load", measure);

  function scrollTarget(): number {
    const y = scrollY;
    if (y <= anchors[0].y) return HERO;
    for (let j = 0; j < anchors.length - 1; j++) {
      const a = anchors[j];
      const b = anchors[j + 1];
      if (y < b.y) {
        const f = (y - a.y) / Math.max(1, b.y - a.y);
        const [w0, w1] = a.win;
        return HERO + j + Math.min(1, Math.max(0, (f - w0) / (w1 - w0)));
      }
    }
    return HERO + anchors.length - 1;
  }

  // ---- Project index: smooth-scroll to a project ----
  const indexItems = [...document.querySelectorAll<HTMLButtonElement>(".pi-item")];
  indexItems.forEach((b) =>
    b.addEventListener("click", () => {
      const i = Number(b.dataset.index);
      scrollTo({ top: anchors[1 + i].y, behavior: engine.reducedMotion ? "auto" : "smooth" });
    }),
  );

  // ---- Per-frame sync ----
  let lastY = scrollY;
  let lastT = performance.now();
  let vel = 0;
  let introDone = false;
  let introP = 0;
  let lastMove = 0;
  /** States from the hero to the experience heading settle on a whole state when scrolling stops. */
  const SETTLE_END = FIRST_PROJECT + projectEls.length;
  const SETTLE_AFTER_MS = 140;

  function frame(now: number) {
    const dt = Math.max(1, now - lastT) / 1000;
    if (scrollY !== lastY) lastMove = now;
    vel += ((scrollY - lastY) / dt - vel) * 0.15;
    lastY = scrollY;
    lastT = now;
    engine.velocity = vel;

    const st = scrollTarget();
    if (!introDone && st > HERO + 0.02) finishIntro();
    if (introDone) {
      // Native scroll is never touched. But when you stop between two
      // projects, the visuals finish the transition to the nearer one, so
      // every resting position shows a complete project.
      const idle = now - lastMove > SETTLE_AFTER_MS;
      engine.target = idle && st < SETTLE_END ? Math.round(st) : st;
    } else {
      // The opening is time-driven and exact: no spring lag.
      engine.target = introP;
      engine.settle();
    }

    // Project text follows the stage's smoothed progress.
    const p = engine.progress;
    let active = 0;
    projectEls.forEach((el, i) => {
      // Outgoing text clears in the first half of a morph, incoming text
      // arrives in the second half: the swap lands when the image is scattered.
      const d = Math.max(-1, Math.min(1, (p - (FIRST_PROJECT + i)) * 2));
      el.style.setProperty("--d", d.toFixed(4));
      el.style.setProperty("--o", Math.max(0, 1 - Math.abs(d) * 0.9).toFixed(3));
      const on = Math.abs(d) < 0.5;
      el.classList.toggle("is-active", on);
      el.setAttribute("aria-hidden", on ? "false" : "true");
      if (on) active = i;
    });
    railIndex.textContent = String(active + 1).padStart(2, "0");
    const inScene = p > FIRST_PROJECT - 0.5 && p < SETTLE_END - 0.5;
    indexItems.forEach((b, i) => b.classList.toggle("is-current", inScene && i === active));
    const rp = (p - FIRST_PROJECT) / Math.max(1, projectEls.length - 1);
    railFill.style.transform = `scaleX(${Math.max(0, Math.min(1, rp)).toFixed(4)})`;
    requestAnimationFrame(frame);
  }

  // ---- Opening ----
  const intros = [...document.querySelectorAll<HTMLElement>("[data-intro]")];
  const caret = document.getElementById("boot-caret")!;
  const lines = [document.getElementById("boot-1")!, document.getElementById("boot-2")!];
  let typing = false;

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function caretPoint() {
    const r = caret.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  }
  function fillLines() {
    for (const l of lines) l.textContent = l.dataset.text ?? "";
    lines[1].after(caret);
  }
  /** Show each intro element as the growing wave reaches it. */
  function showTextAsWavePasses(bloomMs: number) {
    const r = bloom().w / 2;
    for (const el of intros) {
      const b = el.getBoundingClientRect();
      const d = Math.hypot(b.left + 24 - origin.x, b.top + b.height / 2 - origin.y);
      // Invert the bloom's ease-out to find when its edge reaches distance d.
      const frac = Math.min(0.999, d / (r * 0.75));
      const t = 1 - Math.cbrt(1 - frac);
      setTimeout(() => el.classList.add("in"), t * bloomMs + 80);
    }
  }

  let raf = 0;
  /** seed → bloom (the wave grows out of the caret) → hero (it travels into the ellipse and starts cycling). */
  function playWave(bloomMs: number, morphMs: number) {
    origin = caretPoint();
    showTextAsWavePasses(bloomMs);
    const t0 = performance.now();
    const step = (now: number) => {
      const e = now - t0;
      if (e < bloomMs) introP = easeOut(e / bloomMs);
      else introP = 1 + easeInOut(Math.min(1, (e - bloomMs) / morphMs));
      if (introP < 2) raf = requestAnimationFrame(step);
      else introDone = true;
    };
    raf = requestAnimationFrame(step);
  }

  function finishIntro() {
    if (introDone) return;
    typing = false;
    cancelAnimationFrame(raf);
    fillLines();
    introDone = true; // the spring carries the stage from wherever it is to the hero
    intros.forEach((el) => el.classList.add("in"));
  }

  async function typeLine(el: HTMLElement, cps: number) {
    const text = el.dataset.text ?? "";
    el.after(caret);
    for (let i = 1; i <= text.length && typing; i++) {
      el.textContent = text.slice(0, i);
      await sleep(1000 / cps + Math.random() * 30);
    }
  }

  async function boot() {
    try {
      localStorage.setItem("gimk:booted", "1");
    } catch {}
    if (engine.reducedMotion) {
      origin = caretPoint();
      return finishIntro();
    }
    for (const ev of ["keydown", "pointerdown", "wheel", "touchstart"]) {
      addEventListener(ev, finishIntro, { once: true, passive: true });
    }
    typing = true;
    await sleep(350);
    await typeLine(lines[0], 22);
    await sleep(260);
    await typeLine(lines[1], 30);
    for (let i = 0; i < 3 && typing; i++) {
      lines[1].textContent += ".";
      await sleep(180);
    }
    if (introDone) return;
    await sleep(220);
    playWave(1500, 2200);
  }

  engine.start();
  requestAnimationFrame(frame);
  // Dev-only handle for inspecting frames from the console.
  if (import.meta.env.DEV) (window as unknown as { __stage: AsciiEngine }).__stage = engine;
  if (booting) {
    boot();
  } else {
    // Returning visitors: no typing, a quicker wave.
    fillLines();
    if (scrollY > 10 || engine.reducedMotion) {
      origin = caretPoint();
      finishIntro();
      engine.target = scrollTarget();
      engine.settle();
    } else {
      playWave(800, 1300);
    }
  }
</script>

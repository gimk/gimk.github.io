---
import { getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageIntro from "@components/stage/PageIntro.astro";
import ExperienceCounter from "@components/ExperienceCounter.astro";
import { WORK } from "@consts";

const collection = (await getCollection("work")).sort(
  (a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf(),
);

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  }),
);
const education = [
  {
    school: "L'atelier des Chefs",
    degree: "CAP Cuisine, culinary arts and chef training",
    years: "2023 — 2024",
    text: "Passed with honors.",
  },
  {
    school: "Chalmers University of Technology",
    degree: "Interaction Design Technologies",
    years: "2017 — 2018",
    text: "Exchange student. I followed courses on interaction design and game design.",
  },
  {
    school: "ESIEE Paris",
    degree: "Engineer degree, Information Systems",
    years: "2013 — 2018",
    text: "During my 5-year engineering master program, I learned different development languages and other general engineer qualities that helped me build my multi-disciplinary education and critical mind. I led 3 student offices as lead designer, and co-founded the Design Club, where I was vice president.",
  },
];
/** "2021 — 2023", or "2024 — Today". */
const years = (start: Date, end: Date | string) =>
  `${start.getFullYear()} — ${end instanceof Date ? end.getFullYear() : end}`;
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <canvas class="ascii-stage" aria-hidden="true" transition:persist="ascii-stage"></canvas>
  <div id="work-page" class="mx-auto max-w-screen-xl px-5 md:px-10">
    <PageIntro
      back={{ href: "/", label: "Home" }} label={`Experience — ${work.length} companies`} title="Work">
      <p data-reveal data-edge class="max-w-md font-serif text-xl leading-snug opacity-80" style="--i:3">
        <ExperienceCounter /> across {work.length} companies, bridging product, design and code.
      </p>
    </PageIntro>

    <ul id="work-list" class="flex flex-col gap-24 pb-24 m-0 p-0 list-none">
      {
        work.map((entry) => (
          <li class="grid gap-4 md:grid-cols-[11rem_1fr] md:gap-8 md:w-2/3">
            <p data-edge class="eyebrow md:sticky md:top-28 self-start">
              {years(entry.data.dateStart, entry.data.dateEnd)}
            </p>
            <div class="flex flex-col gap-3">
              <h2 data-edge class="display text-4xl md:text-5xl leading-none">
                {entry.data.company}
              </h2>
              <p data-edge class="eyebrow">{entry.data.role}</p>
              <article data-edge class="mt-3 font-serif prose-sm">
                <entry.Content />
              </article>
            </div>
          </li>
        ))
      }
    </ul>

    <section aria-labelledby="education-title" class="pb-[25vh]">
      <p data-edge class="eyebrow mb-3">Education</p>
      <h2 id="education-title" data-edge class="display text-4xl md:text-5xl leading-none mb-16">
        Schools
      </h2>
      <ul class="flex flex-col gap-16 m-0 p-0 list-none">
        {
          education.map((entry) => (
            <li class="grid gap-4 md:grid-cols-[11rem_1fr] md:gap-8 md:w-2/3">
              <p data-edge class="eyebrow md:sticky md:top-28 self-start">{entry.years}</p>
              <div class="flex flex-col gap-3">
                <h3 data-edge class="display text-3xl md:text-4xl leading-none">{entry.school}</h3>
                <p data-edge class="eyebrow">{entry.degree}</p>
                <p data-edge class="mt-3 font-serif prose-sm">{entry.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</PageLayout>

<script>
  import {
    onPage,
    createStage,
    side,
    sideFocus,
    PLAYLIST,
    scrollProgress,
    docTop,
    edgeBlur,
    type Anchor,
  } from "@lib/ascii/stage";
  import type { AsciiState } from "@lib/ascii/types";

  onPage("#work-page", () => {
    const page = document.getElementById("work-page")!;
    const list = document.getElementById("work-list")!;
    const canvas = document.querySelector<HTMLCanvasElement>(".ascii-stage")!;

    const stage = createStage(canvas);
    const { engine } = stage;
    const states: AsciiState[] = [
      { id: "intro", field: "wave", fields: PLAYLIST, period: 6, accent: 0.8, shape: null, frame: side, focus: sideFocus, intensity: 1, ambient: 1 },
      { id: "list", field: "calm", shape: null, frame: side, focus: sideFocus, intensity: 0.5, ambient: 0.9 },
    ];
    engine.setStates(states);

    let anchors: Anchor[] = [];
    function measure() {
      anchors = [{ y: 0, win: [0.2, 1] }, { y: Math.max(1, docTop(list) - innerHeight * 0.2), win: [0, 1] }];
    }
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(document.body);

    const blur = edgeBlur([...page.querySelectorAll<HTMLElement>("[data-edge]")], engine.reducedMotion);
    engine.target = scrollProgress(anchors);
    engine.settle();
    engine.start();

    let raf = 0;
    let lastY = scrollY;
    let lastT = performance.now();
    function frame(now: number) {
      const dt = Math.max(1, now - lastT) / 1000;
      engine.velocity += ((scrollY - lastY) / dt - engine.velocity) * 0.15;
      lastY = scrollY;
      lastT = now;
      engine.target = scrollProgress(anchors);
      blur();
      raf = requestAnimationFrame(frame);
    }
    raf = requestAnimationFrame(frame);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      stage.destroy();
    };
  });
</script>

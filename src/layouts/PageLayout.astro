---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Lightbox from "@components/Lightbox.astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
};

const { title, description, image, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | Pantoine.com`} description={description} image={image} type={type} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" style="outline: none">
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>

<script>
  // ASCII glyph shimmer on small text links (see scripts/glyph-shimmer.ts).
  import { initGlyphShimmer } from "../scripts/glyph-shimmer";
  document.addEventListener("astro:page-load", initGlyphShimmer);
</script>
